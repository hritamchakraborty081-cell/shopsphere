# ---- ShopSphere environment template: PLACEHOLDERS ONLY. Copy to .env and edit. ----
NODE_ENV=development
PORT=4000

# PostgreSQL. In production use a least-privilege role (no DDL) for the app and a separate migration role.
DATABASE_URL=postgresql://shopsphere:CHANGE_ME@localhost:5432/shopsphere
TEST_DATABASE_URL=postgresql://shopsphere:CHANGE_ME@localhost:5432/shopsphere_test
# Browser (Playwright) tests use their own database; the name must contain "e2e" or "test".
E2E_DATABASE_URL=postgresql://shopsphere:CHANGE_ME@localhost:5432/shopsphere_e2e

# Browser origins allowed to call the API (comma separated, exact match).
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in emailed links).
APP_URL=http://localhost:5173

# Session cookie. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Payments: "mock" is a clearly-labelled local adapter. No real money / card data is ever handled.
PAYMENT_PROVIDER=mock
# HMAC secret used to sign/verify mock webhook payloads. Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Dev-only: exposes GET /api/v1/dev/outbox with captured emails (verification/reset links).
# MUST be false in production; the server refuses to start if it is true in production.
ENABLE_DEV_OUTBOX=true
# Serve Swagger UI at /api/v1/docs (disabled by default in production).
ENABLE_DOCS=true
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting).
TRUST_PROXY=0

# Seed script demo password (development only).
SEED_DEMO_PASSWORD=CHANGE_ME_demo_password_123

# ---- docker compose only ----
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shopsphere
WEB_PORT=8080
